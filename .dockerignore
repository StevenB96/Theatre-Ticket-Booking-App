# Node modules (will be installed inside the container)
node_modules
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (will be generated inside container)
.next

# Dockerfile itself and docker-compose if you want to exclude them (optional)
Dockerfile
docker-compose.yml

# Git files
.git
.gitignore

# MacOS system files
.DS_Store

# Editor files
.vscode
.idea

# Tests output or coverage (optional)
coverage

dev.sqlite3
